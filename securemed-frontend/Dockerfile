# 1. Install dependencies
FROM oven/bun:1 AS deps
WORKDIR /app
COPY package.json bun.lock ./
# Relaxed install to prevent lockfile mismatch errors in the cloud
RUN bun install

# 2. Production build
FROM deps AS builder
WORKDIR /app
COPY . .
ARG BACKEND_URL
ENV BACKEND_URL=$BACKEND_URL
RUN bun run build

# 3. Production runtime
FROM oven/bun:1 AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=8080 \
    HOSTNAME=0.0.0.0

# Debian-compatible user creation
RUN (getent group nodejs || groupadd --system --gid 1001 nodejs) && \
    (getent passwd nextjs || useradd --system --uid 1001 --gid nodejs nextjs)

# Copy standalone build files
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 8080
# Run the standalone server generated by Next.js
CMD ["node", "server.js"]